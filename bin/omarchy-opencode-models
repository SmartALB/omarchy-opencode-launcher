#!/usr/bin/env bash
# Modell-Liste fuer das Panel: was das installierte opencode erreichen kann.
# Faellt auf den Cache zurueck, wenn der Aufruf scheitert oder haengt -- ein
# ausgeschalteter LM-Studio-Server darf die Bar nicht blockieren.
set -uo pipefail
. "$(dirname "$(readlink -f "$0")")/_common.sh"

ME="$(basename "$0")"
STORE="$(dirname "$(readlink -f "$0")")/omarchy-opencode-store"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/smartalb.opencode"
CACHE="$CACHE_DIR/models.json"
MAX_MODELS=2000
TIMEOUT="${OC_MODELS_TIMEOUT:-5}"
REFRESH_HOURS="${OC_REFRESH_HOURS:-24}"

[ "${1:-}" = "list" ] && [ "${2:-}" = "--json" ] || {
  echo "Usage: $ME list --json [--refresh]" >&2; exit 1; }
refresh=false
[ "${3:-}" = "--refresh" ] && refresh=true

emit() {  # emit <source> <stale> <capped> <ids…auf stdin>
  local src="$1" stale="$2" capped="$3"
  local stars; stars="$("$STORE" stars 2>/dev/null | "$BIN_JQ" -R -s 'split("\n") - [""]')"
  "$BIN_JQ" -R -s \
    --arg src "$src" --argjson stale "$stale" --argjson capped "$capped" \
    --argjson stars "$stars" --arg now "$("$BIN_DATE" -u +%Y-%m-%dT%H:%M:%SZ)" '
    (split("\n") - [""]) as $ids
    | { generatedAt: $now, stale: $stale, source: $src, capped: $capped,
        models: ($ids | map({
            id: .,
            provider: (split("/")[0]),
            label: (split("/") | last),
            starred: (. as $i | $stars | index($i) != null)
          })
          # Nur nach starred sortieren, nicht zusaetzlich nach id: ein
          # zweites Sortierkriterium wuerde innerhalb der unmarkierten
          # Modelle alphabetisch umsortieren und die von opencode gelieferte
          # Reihenfolge zerstoeren -- sort_by in jq ist stabil, daher reicht
          # das starred-Kriterium allein, um Sterne nach oben zu holen und
          # alles andere unangetastet zu lassen.
          | sort_by(if .starred then 0 else 1 end)) }'
}

emit_error() {  # emit_error <code>
  "$BIN_JQ" -nc --arg e "$1" --arg now "$("$BIN_DATE" -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{generatedAt:$now, stale:true, source:"none", capped:false, models:[], error:$e}'
}

# Ruling 19: dieselbe Datei-Art-Pruefung wie omarchy-opencode-store fuer
# seine Zustandsdatei -- ein Symlink am Cache-Pfad wuerde read_capped
# lesen lassen, wohin er auch zeigt, und "[ -f "$CACHE" ]" alleine reicht
# nicht: dieser Test folgt Symlinks (ein Symlink auf eine gueltige JSON-
# Datei besteht ihn). "stat" (ohne -L) liefert dagegen die Metadaten des
# Symlinks selbst, nicht des Ziels -- deshalb pruefen wir separat und
# zuerst per "-L". Anders als beim Zustandsspeicher darf dieses Skript
# nicht mit Exit 6 abbrechen (das Panel sammelt stdout ein), sondern muss
# den Fehler im JSON melden: emit_error statt return.
cache_is_invalid() {
  [ -L "$CACHE" ] && return 0
  [ -e "$CACHE" ] && [ ! -f "$CACHE" ] && return 0
  return 1
}

cache_fresh() {
  [ -f "$CACHE" ] || return 1
  [ "$REFRESH_HOURS" -gt 0 ] || return 1
  local age_limit="$((REFRESH_HOURS * 3600))" mtime now
  mtime="$("$BIN_STAT" -c %Y "$CACHE" 2>/dev/null)" || return 1
  now="$("$BIN_DATE" +%s)"
  [ "$((now - mtime))" -lt "$age_limit" ]
}

serve_cache() {  # serve_cache <stale>; gibt validierten Cache aus, oder 1 wenn keiner existiert
  local stale="$1" data rc ids capped id
  [ -L "$CACHE" ] || [ -e "$CACHE" ] || return 1
  if cache_is_invalid; then
    emit_error "cache-not-a-file"
    return 0
  fi
  rc=0
  data="$(read_capped "$CACHE" "$MAX_FILE")" || rc=$?
  if [ "$rc" = 8 ]; then
    emit_error "cache-too-large"
    return 0
  elif [ "$rc" != 0 ]; then
    emit_error "cache-unreadable"
    return 0
  fi

  # Ein Cache ist kein Vertrauensanker. Nur die von diesem Skript erzeugte
  # Form wird akzeptiert; besonders wichtig sind echte Modellobjekte mit
  # syntaktisch gueltigen IDs. provider/label/starred werden anschliessend
  # ohnehin neu erzeugt, damit Sterne immer aus dem aktuellen Store kommen.
  if ! printf '%s' "$data" | "$BIN_JQ" -e '
      type == "object"
      and (.models | type == "array" and length > 0)
      and (.models | all(type == "object" and (.id | type == "string")))
      and ((.capped // false) | type == "boolean")
    ' >/dev/null 2>&1; then
    emit_error "cache-invalid"
    return 0
  fi

  # @tsv escaped Steuerzeichen, bevor Bash nach Zeilen trennt. Ohne diese
  # Huelle wuerde eine einzelne ID mit eingebettetem Zeilenumbruch als zwei
  # scheinbar gueltige IDs validiert und anschliessend umgedeutet.
  ids="$(printf '%s' "$data" | "$BIN_JQ" -r '.models[] | [.id] | @tsv')" || {
    emit_error "cache-invalid"
    return 0
  }
  while IFS= read -r id; do
    valid_model_id "$id" || {
      emit_error "cache-invalid"
      return 0
    }
  done <<< "$ids"
  capped="$(printf '%s' "$data" | "$BIN_JQ" -r '.capped // false')"
  printf '%s\n' "$ids" | emit "cache" "$stale" "$capped"
  return 0
}

if [ "$refresh" = false ] && cache_fresh; then
  if serve_cache false; then
    exit 0
  fi
fi

OPENCODE="${OPENCODE_BIN:-$(command -v opencode 2>/dev/null || true)}"

if [ -z "$OPENCODE" ] || [ ! -x "$OPENCODE" ]; then
  serve_cache true || emit_error "opencode-missing"
  exit 0
fi

raw=""
rc=0
# Ruling 20: "-k 5" toetet mit SIGKILL, falls der Kindprozess SIGTERM
# ignoriert -- ohne das stuende das Versprechen "die Bar blockiert nie"
# auf der Kulanz des Kindprozesses. Dieselbe Form wie beim runner()-Helfer
# des Panels (siehe Design-Dokument).
raw="$("$BIN_TIMEOUT" -k 5 "$TIMEOUT" "$OPENCODE" models 2>/dev/null | read_stream_capped "$MAX_FILE")" || rc=$?
if [ "$rc" = 8 ]; then
  serve_cache true || emit_error "models-too-large"
  exit 0
fi
if [ "$rc" != 0 ] || [ -z "$raw" ]; then
  serve_cache true || emit_error "models-unavailable"
  exit 0
fi

# Nur syntaktisch gueltige IDs, und die Kardinalitaet vor allem Weiteren
# gekappt: 2500 Zeilen sind keine Antwort, sondern eine Flut.
ids="$(printf '%s\n' "$raw" | while IFS= read -r line; do
         valid_model_id "$line" && printf '%s\n' "$line"
       done)"
count="$(printf '%s' "$ids" | grep -c . || true)"
capped=false
if [ "$count" -gt "$MAX_MODELS" ]; then
  ids="$(printf '%s\n' "$ids" | "$BIN_HEAD" -n "$MAX_MODELS")"
  capped=true
fi

out="$(printf '%s\n' "$ids" | emit "opencode" false "$capped")"

# C1: einen LEEREN Katalog nie zwischenspeichern. Ein einziger schlechter
# "opencode models"-Lauf -- ein Erstlauf-Banner statt einer Liste, kein
# konfigurierter Provider, ein Anbieter, der gerade nichts liefert --
# endete hier bisher als leere, aber FRISCHE Cache-Datei: cache_fresh()
# stimmte dann fuer die naechsten catalogRefreshHours (Standard 24 h) zu,
# und der Picker blieb so lange leer, obwohl der naechste Aufruf wieder
# funktioniert haette. Ein vorhandener, alter Cache mit echtem Inhalt ist
# in jedem Fall besser als ein frischer, leerer.
#
# "Fuer diesen Aufruf melden, aber nicht ablegen": das leere Ergebnis geht
# unveraendert auf stdout (es ist ja das, was opencode gerade gesagt hat),
# nur der Cache bleibt unberuehrt -- der naechste Aufruf fragt deshalb
# wieder wirklich nach.
if [ "$count" -eq 0 ]; then
  printf '%s\n' "$out"
  exit 0
fi

mkdir -p "$CACHE_DIR"
# Ruling 19: dieselbe Pruefung auch vor dem Schreiben -- sonst wuerde ein
# Symlink am Cache-Pfad hier stillschweigend durch "mv -f" ersetzt statt
# abgelehnt zu werden. Das frisch geholte Ergebnis geht trotzdem auf
# stdout: nur das Ablegen im Cache wird uebersprungen, nicht die Antwort.
if cache_is_invalid; then
  :
else
  tmp="$("$BIN_MKTEMP" "$CACHE_DIR/.models.json.XXXXXX")" && {
    printf '%s' "$out" > "$tmp" && chmod 600 "$tmp" && "$BIN_MV" -f "$tmp" "$CACHE" || rm -f "$tmp"
  }
fi
printf '%s\n' "$out"
