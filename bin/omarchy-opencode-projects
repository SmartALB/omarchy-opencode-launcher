#!/usr/bin/env bash
# Projektliste fuer das Panel: gepinnte Projekte aus der Config, danach
# Recents aus opencodes Datenbank.
#
# Die Recents kommen direkt aus der DB, nicht aus `opencode session list`:
# die CLI filtert nach dem Projekt des Arbeitsverzeichnisses, und dieses
# Skript laeuft mit dem cwd der Shell -- die Ergebnisse waeren zufaellig.
#
# Ein einziger jq-Aufruf baut das JSON, und ein einziger hyprctl-Aufruf
# klaert den Laufzustand. Ein Unterprozess je Projekt waere die Laufzeit
# "Projekte x Aufruf" ueber eine Liste, die der Benutzer schreibt.
set -uo pipefail
. "$(dirname "$(readlink -f "$0")")/_common.sh"

ME="$(basename "$0")"
CFG_NEW="$HOME/.config/omarchy/opencode-launcher.json"
CFG_OLD="$HOME/.config/omarchy/opencode-projects.json"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/smartalb-opencode/projects.json"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/smartalb.opencode/models.json"
DB="${OPENCODE_DB:-$HOME/.local/share/opencode/opencode.db}"
RECENTS="${OC_RECENT_COUNT:-5}"
MAX_PROJECTS="${OC_MAX_PROJECTS:-200}"

[ "${1:-}" = "list" ] && [ "${2:-}" = "--json" ] || {
  echo "Usage: $ME list --json" >&2; exit 1; }

die_json() { "$BIN_JQ" -nc --arg e "$1" '{error:$e}'; exit "$2"; }

OPENCODE="${OPENCODE_BIN:-$(command -v opencode 2>/dev/null || true)}"
[ -n "$OPENCODE" ] && [ -x "$OPENCODE" ] || die_json "opencode-missing" 3

# --- Config lesen ------------------------------------------------------------
cfg='{"projects":[]}'
cfg_file=""
[ -f "$CFG_NEW" ] && cfg_file="$CFG_NEW"
[ -z "$cfg_file" ] && [ -f "$CFG_OLD" ] && cfg_file="$CFG_OLD"
if [ -n "$cfg_file" ]; then
  raw="$(read_capped "$cfg_file" "$MAX_FILE")" || {
    [ "$?" = 8 ] && die_json "config-too-large" 8
    die_json "config-unreadable" 9
  }
  printf '%s' "$raw" | "$BIN_JQ" -e . >/dev/null 2>&1 || die_json "config-unreadable" 9
  cfg="$raw"
fi

# --- Zustand und Modell-Cache lesen (nur lesend) -----------------------------
# Ruling 19: dieselbe Symlink-/Datei-Art-Pruefung wie bei Task 2 (Zustand)
# und Task 3 (Modell-Cache) -- ein Symlink an einem der beiden Pfade wuerde
# sonst stillschweigend verfolgt, und "absent" und "hier liegt ein Symlink"
# sind zwei verschiedene Tatsachen. Anders als beim Modell-Cache (Task 3),
# der bei ungueltigem Cache noch eine leere, aber sinnvolle Antwort liefern
# kann, waere ein still auf {} zurueckfallender Zustand hier falsch: das
# Panel wuerde "kein Modell gemerkt" von "hier hat jemand einen Symlink
# hingelegt" nicht unterscheiden koennen. Deshalb bricht der ganze Aufruf
# ab, mit Exit 6 ("Datei ist keine einfache Datei") und derselben Fehlerform
# wie config-unreadable & Co.
not_a_file() {  # not_a_file <pfad>
  [ -L "$1" ] && return 0
  [ -e "$1" ] && [ ! -f "$1" ] && return 0
  return 1
}
not_a_file "$STATE" && die_json "state-not-a-file" 6
not_a_file "$CACHE" && die_json "cache-not-a-file" 6

state='{"projects":{}}'
if [ -f "$STATE" ]; then
  s="$(read_capped "$STATE" "$MAX_FILE")"; rc=$?
  if [ "$rc" = 8 ]; then
    # Ruling 26: eine zu grosse Zustandsdatei sieht sonst genauso aus wie
    # "kein Projekt hat je ein Modell gemerkt" -- das "&&" nach read_capped
    # scheitert einfach lautlos und der Standard bleibt stehen. "Abwesend"
    # und "zu gross" sind verschiedene Tatsachen (dieselbe Begruendung wie
    # bei Ruling 19 fuer Symlinks).
    die_json "state-too-large" 8
  elif [ "$rc" = 0 ] && printf '%s' "$s" | "$BIN_JQ" -e . >/dev/null 2>&1; then
    # Ruling 25: gueltiges JSON reicht nicht -- "{"projects":[]}" oder
    # "{"projects":"x"}" besteht die reine "-e ."-Pruefung anstandslos und
    # stuerzt danach im abschliessenden jq an "$state.projects[$p]" ab
    # ("Cannot index array with string"), mit leerem stdout. Form und
    # schemaVersion daher hier pruefen, bevor $state ueberhaupt in den
    # letzten jq-Aufruf geht -- derselbe Massstab, den
    # omarchy-opencode-store an seine eigenen Schreibvorgaenge anlegt.
    ver="$(printf '%s' "$s" | "$BIN_JQ" -r '.schemaVersion // 0' 2>/dev/null)"
    if [ "$ver" != "1" ]; then
      die_json "state-schema-unknown" 7
    fi
    proj_type="$(printf '%s' "$s" | "$BIN_JQ" -r '(.projects // {}) | type' 2>/dev/null)"
    if [ "$proj_type" != "object" ]; then
      die_json "state-invalid" 9
    fi
    state="$s"
  fi
fi

known='[]'
if [ -f "$CACHE" ]; then
  c="$(read_capped "$CACHE" "$MAX_FILE")"; rc=$?
  if [ "$rc" = 8 ]; then
    # Ruling 26, spiegelbildlich zum Zustand oben.
    die_json "cache-too-large" 8
  elif [ "$rc" = 0 ]; then
    # "-ce" statt blossem "-c || echo '[]'": jq liest bei leerem stdin
    # (z.B. eine 0-Byte-Cache-Datei) NULL Dokumente ein, wendet den Filter
    # nie an, gibt nichts aus und beendet sich trotzdem mit Erfolg -- das
    # "|| echo '[]'"-Netz greift dann nicht, "known" bliebe ein leerer
    # String, und der abschliessende --argjson-Aufruf stuerzte mit "invalid
    # JSON text" ab. "-e" macht daraus verlaesslich einen Fehlschlag (Exit 4,
    # "kein Ergebnis"), den die Kette hier auffaengt.
    k="$(printf '%s' "$c" | "$BIN_JQ" -ce '[(.models // [])[].id]' 2>/dev/null)" && known="$k"
  fi
fi

# --- Pfade sammeln: gepinnt, dann Recents, gekappt VOR allem Weiteren --------
pinned_tsv="$(printf '%s' "$cfg" | "$BIN_JQ" -r '
  (.projects // [])[] | [(.name // ""), (.path // "")] | @tsv' 2>/dev/null || true)"

declare -a PATHS=() NAMES=() PINNED=()
CAPPED=false
add() {
  [ "${#PATHS[@]}" -lt "$MAX_PROJECTS" ] || { CAPPED=true; return 1; }
  PATHS+=("$1"); NAMES+=("$2"); PINNED+=("$3")
}

while IFS=$'\t' read -r name rawpath; do
  [ -n "$rawpath" ] || continue
  p="$(expand_path "$rawpath")"
  [ -n "$name" ] || name="$(tilde_abbrev "$p")"
  add "$p" "$name" true || break
done <<< "$pinned_tsv"

# "${#PATHS[@]}" -lt "$MAX_PROJECTS": ist die Kappung schon durch die
# gepinnten Projekte allein erreicht, waere jede Zeile aus der DB ohnehin
# verworfen -- dann den sqlite3-Unterprozess erst gar nicht anstossen. Genau
# der Sinn der Kappung: keine Arbeit fuer eine Liste, die niemand angefordert
# hat.
if [ "${#PATHS[@]}" -lt "$MAX_PROJECTS" ] && [ "$RECENTS" -gt 0 ] && [ -f "$DB" ] && command -v "$BIN_SQLITE" >/dev/null 2>&1; then
  added=0
  while IFS= read -r rpath; do
    [ -n "$rpath" ] || continue
    dup=false
    for q in ${PATHS+"${PATHS[@]}"}; do [ "$q" = "$rpath" ] && { dup=true; break; }; done
    [ "$dup" = true ] && continue
    add "$rpath" "$(tilde_abbrev "$rpath")" false || break
    added=$((added + 1)); [ "$added" -ge "$RECENTS" ] && break
  done < <("$BIN_TIMEOUT" 5 "$BIN_SQLITE" "$DB" ".timeout 3000" "
      SELECT directory FROM session
      WHERE directory IS NOT NULL AND directory != ''
      GROUP BY directory ORDER BY MAX(time_updated) DESC LIMIT 50;" 2>/dev/null || true)
fi

# --- Ein hyprctl-Aufruf, nach der Kappung ------------------------------------
classes='[]'
if command -v "$BIN_HYPRCTL" >/dev/null 2>&1; then
  # Dieselbe "-ce"-Absicherung wie beim Modell-Cache oben: eine leere
  # hyprctl-Antwort (Timeout, Absturz, oder -- wie im Test fuer Ruling 24 --
  # ein Doppelgaenger, der nichts ausgibt) fuehrt sonst zu einem leeren
  # "classes"-String statt "[]" und reisst den letzten jq-Aufruf mit "invalid
  # JSON text passed to --argjson" mit runter.
  h="$("$BIN_TIMEOUT" 5 "$BIN_HYPRCTL" clients -j 2>/dev/null | read_stream_capped "$MAX_FILE")" \
    && c="$(printf '%s' "$h" | "$BIN_JQ" -ce '[.[].class // empty]' 2>/dev/null)" \
    && classes="$c"
fi

# --- Ein jq-Aufruf baut die Antwort -----------------------------------------
{
  i=0
  while [ "$i" -lt "${#PATHS[@]}" ]; do
    exists=false; [ -d "${PATHS[$i]}" ] && exists=true
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
      "${NAMES[$i]}" "${PATHS[$i]}" "$(tilde_abbrev "${PATHS[$i]}")" \
      "$(app_id_for "${PATHS[$i]}")" "${PINNED[$i]}" "$exists"
    i=$((i + 1))
  done
} | "$BIN_JQ" -R -s --argjson state "$state" --argjson known "$known" \
        --argjson classes "$classes" --argjson capped "$CAPPED" '
  (split("\n") - [""]) | map(split("\t")) | map(
    . as $row
    # "$row" statt blossem "." nach dem Pipe zu $classes: "$classes |
    # index(.[3])" wuerde .[3] gegen $classes selbst auswerten (das ist
    # nach dem Pipe das neue "."), nicht gegen die Zeile -- der Vergleich
    # traefe dann nie und running bliebe immer false.
    | ($row[1]) as $p
    | ($state.projects[$p].model // null) as $m
    | { name: $row[0], path: $p, displayPath: $row[2], appId: $row[3],
        pinned: ($row[4] == "true"), exists: ($row[5] == "true"), capped: $capped,
        running: ($classes | index($row[3]) != null),
        model: $m,
        modelLabel: (if $m == null then null else ($m | split("/") | last) end),
        modelKnown: (if $m == null then true
                     elif ($known | length) == 0 then true
                     else ($known | index($m) != null) end) })'
