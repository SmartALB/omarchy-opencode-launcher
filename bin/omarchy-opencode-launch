#!/usr/bin/env bash
# Oeffnet opencode im Projektverzeichnis, mit dem gewaehlten Modell, oder
# fokussiert das bereits laufende Fenster dieses Projekts.
#
# Usage: omarchy-opencode-launch <dir> [--model ID] [--agent N] [--continue] [--new-window]
set -uo pipefail
. "$(dirname "$(readlink -f "$0")")/_common.sh"

ME="$(basename "$0")"
LOF="${OMARCHY_LAUNCH_OR_FOCUS:-omarchy-launch-or-focus}"

usage() { echo "Usage: $ME <dir> [--model ID] [--agent NAME] [--continue] [--new-window]" >&2; exit 1; }

[ $# -ge 1 ] || usage
dir="$(expand_path "$1")"; shift
model=""; agent=""; cont=false; newwin=false
while [ $# -gt 0 ]; do
  case "$1" in
    --model) [ $# -ge 2 ] || usage; model="$2"; shift 2 ;;
    --agent) [ $# -ge 2 ] || usage; agent="$2"; shift 2 ;;
    --continue) cont=true; shift ;;
    --new-window) newwin=true; shift ;;
    *) usage ;;
  esac
done

[ -d "$dir" ] || { echo "$ME: not a directory: $dir" >&2; exit 2; }

OPENCODE="${OPENCODE_BIN:-$(command -v opencode 2>/dev/null || true)}"
[ -n "$OPENCODE" ] && [ -x "$OPENCODE" ] || { echo "$ME: opencode is not installed" >&2; exit 3; }

# Vor dem Bauen der Zeile pruefen, nicht danach: eine kaputte ID darf nicht
# in eine eval-Zeile geraten.
if [ -n "$model" ]; then
  valid_model_id "$model" || { echo "$ME: invalid model id: $model" >&2; exit 4; }
fi
if [ -n "$agent" ]; then
  valid_agent_name "$agent" || { echo "$ME: invalid agent name: $agent" >&2; exit 5; }
fi

# Ruling 33: die App-Id haengt am Slug von app_id_for ab, und der wiederum
# am Pfad-Text selbst -- "." und "/abs/proj" ergeben zwei verschiedene
# App-Ids fuer dasselbe Projekt, und Fokussieren oeffnet dann still ein
# zweites Fenster statt das erste zu finden. Deshalb nur fuer die App-Id
# kanonisieren; der Pfad, der unten an --dir uebergeben wird, bleibt wie
# eingegeben -- das betrifft Anzeige/Funktion, nicht Identitaet.
#
# A1: die Formel selbst steht jetzt als canon_dir() in _common.sh, weil
# omarchy-opencode-projects dieselbe braucht und die beiden Kopien
# auseinandergelaufen sind.
app_id="$(app_id_for "$(canon_dir "$dir")")"

# omarchy-launch-or-focus fuehrt sein zweites Argument per eval aus. Jeder
# eingesetzte Wert muss daher durch printf %q -- ein Projektpfad mit
# Leerzeichen zerfiele sonst in zwei Argumente.
#
# Das doppelte setsid ist beabsichtigt: der Empfaenger fuehrt selbst
# "eval exec setsid $LAUNCH_COMMAND" aus, umschliesst unser "setsid
# uwsm-app -- ..." also noch mit einem eigenen. Der --new-window-Pfad weiter
# unten laeuft nie durch den Empfaenger und braucht sein eigenes setsid, um
# die neue Sitzung selbst abzuloesen.
cmd="setsid uwsm-app -- xdg-terminal-exec"
cmd="$cmd --app-id=$(printf %q "$app_id")"
cmd="$cmd --dir=$(printf %q "$dir")"
# Ruling 31: das gepruefte Programm ist auch das gestartete -- bare "opencode"
# wuerde in der frischen uwsm-app/systemd-Unit erneut per PATH gesucht, das
# dort aber nicht zwingend denselben Eintrag (z.B. ~/.local/bin) enthaelt wie
# die Shell dieses Skripts. Ohne diese Zeile waere OPENCODE_BIN nur fuer die
# Existenzpruefung wirksam, nie fuer den tatsaechlichen Start.
# OpenCode V2 hat die alten CLI-Flags -m/--model und --agent entfernt.
# OPENCODE_CONFIG_CONTENT wird ueber die globale Konfiguration gelegt, gilt
# nur fuer diesen Prozess und schreibt keine Konfigurationsdatei.
inline_config=""
if [ -n "$model" ] || [ -n "$agent" ]; then
  inline_config="$("$BIN_JQ" -cn --arg model "$model" --arg agent "$agent" '
    {}
    + (if $model != "" then {model: $model} else {} end)
    + (if $agent != "" then {default_agent: $agent} else {} end)
  ')" || { echo "$ME: could not build OpenCode configuration" >&2; exit 6; }
fi

cmd="$cmd -e"
if [ -n "$inline_config" ]; then
  cmd="$cmd env OPENCODE_CONFIG_CONTENT=$(printf %q "$inline_config")"
fi
cmd="$cmd $(printf %q "$OPENCODE")"
# opencode 2.x startet per Default den geteilten, abgekoppelten Background-
# Service (serve --service), der TUI-Clients bewusst ueberdauert. Dieser
# Launcher oeffnet aber jede Sitzung in einer EIGENEN transienten
# uwsm-app/xdg-terminal-exec-Scope; der Service landet in deren cgroup und
# bleibt beim Fensterschliessen dort liegen. Ein systemd-Scope wird erst
# freigegeben, wenn sein cgroup leer ist -- also haelt der zurueckgebliebene
# Service den Wegwerf-Scope (und seine LM-Studio-/MCP-Verbindungen) endlos am
# Leben. --standalone bindet stattdessen einen privaten "serve --stdio"-Server
# als Kind an die TUI, der mit dem Fenster stirbt. Verhaltensmaessig
# verifiziert: Client-Tod killt den stdio-Server, kein reparentetes Waisenkind.
cmd="$cmd --standalone"
[ "$cont" = true ] && cmd="$cmd -c"

# stdin/stdout/stderr werden abgekoppelt. Ohne das erbt das gestartete
# Terminal die Pipes des Aufrufers; startet Quickshell dieses Skript aus
# einem Process-Objekt, raeumt es die Pipes ab, sobald die Kette endet -- und
# nimmt das Terminal mit. Das Symptom ist tueckisch: systemd meldet
# "Started xdg-terminal-exec", das Skript endet mit 0, und es erscheint nie
# ein Fenster. Die Pruefungen oben laufen vorher und bleiben sichtbar.
#
# Ruling 2: /usr/bin/bash statt /usr/bin/env bash -- env loest den
# Interpreter ueber den PATH auf, und genau das soll bei einem Interpreter
# nie passieren, auch nicht innerhalb einer bash -c-Zeile (Ruling 21).
if [ "$newwin" = true ]; then
  exec /usr/bin/bash -c "$cmd" </dev/null >/dev/null 2>&1
fi
exec "$LOF" "$app_id" "$cmd" </dev/null >/dev/null 2>&1
